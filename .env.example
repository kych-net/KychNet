DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kych-net
BIND=127.0.0.1:8080
# 内容站地址（同时决定管理端「前往内容端」链接与 canonical）。
SITE_URL=https://kych.net
# 管理端 origin。CORS 与写接口的 Origin 白名单都拿它做等值比较，
# 因此必须是纯 scheme://host[:port]，不能带路径。
ADMIN_ORIGIN=https://kych.net
# 页面里「管理端」链接用的地址，可以带子路径；缺省由 ADMIN_ORIGIN 拼出 /管理/。
# 管理端与内容站同域，挂在 /管理/ 下，所以不能直接复用 ADMIN_ORIGIN 做链接。
# ADMIN_URL=https://kych.net/管理/
# WebAuthn 的 RP ID 取可注册域本身，不要写成子域：RP ID 是凭据绑定域，
# 写成子域的话，日后管理端换域会让已注册的通行密钥全部失效。
WEBAUTHN_RP_ID=kych.net
WEBAUTHN_ORIGIN=https://kych.net
CONTENT_ROOT=content
# 站点产物输出目录，`build` 子命令与管理端触发的重建共用这个路径。
BUILD_OUT_DIR=dist
# 限流用的客户端 IP 来源。确实只经由可信 CDN/反代进来时才设 1（读 X-Forwarded-For）；
# 否则保持 0，用 TCP 对端地址——这个头谁都能伪造，信了就等于让攻击者自己挑额度。
TRUST_PROXY_HEADERS=0
# 从外部导入项目时是否允许内网/回环地址。默认 0：公网地址才能导入，
# 避免借导入功能探测内网；只有确实要连自建内网 Git 服务器时才设 1。
KYCHNET_IMPORT_ALLOW_PRIVATE=0
# 可选：磁盘 Git 对象后端（标准 packfile + idx v2）。默认 pg，不设置时
# 行为与升级前完全一致，不产生磁盘目录；设为 disk 后需同时配置 GIT_ROOT，
# 并按 README 的 offload / repack 流程运维。
# GIT_OBJECT_BACKEND=pg
# GIT_ROOT=git-objects
