DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kychnet
BIND=127.0.0.1:8080
SITE_URL=http://localhost:8080
ADMIN_ORIGIN=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
CONTENT_ROOT=content
# 限流用的客户端 IP 来源。确实只经由可信 CDN/反代进来时才设 1（读 X-Forwarded-For）；
# 否则保持 0，用 TCP 对端地址——这个头谁都能伪造，信了就等于让攻击者自己挑额度。
TRUST_PROXY_HEADERS=0
RUST_LOG=info
