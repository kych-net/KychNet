DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kych-net
BIND=127.0.0.1:8080
# 内容站地址（同时决定管理端「前往内容端」链接与 canonical）。
SITE_URL=https://c.kych.net
# 管理端地址（CORS 与写接口 Origin 白名单都以此为准）。
ADMIN_ORIGIN=https://m.kych.net
# WebAuthn 的 RP ID 取可注册域本身，不要写成子域：RP ID 是凭据绑定域，
# 写成 m.kych.net 的话，日后管理端换子域会让已注册的通行密钥全部失效。
WEBAUTHN_RP_ID=kych.net
WEBAUTHN_ORIGIN=https://m.kych.net
CONTENT_ROOT=content
# 站点产物输出目录，`build` 子命令与管理端触发的重建共用这个路径。
BUILD_OUT_DIR=dist
# 限流用的客户端 IP 来源。确实只经由可信 CDN/反代进来时才设 1（读 X-Forwarded-For）；
# 否则保持 0，用 TCP 对端地址——这个头谁都能伪造，信了就等于让攻击者自己挑额度。
TRUST_PROXY_HEADERS=0
RUST_LOG=info
# 可选：MCP 服务器（/mcp）的 Bearer token。设置后 AI 客户端可通过
# Streamable HTTP 连接 https://kych.net/mcp 查询/写入内容和项目文件；
# token 等同写权限，请妥善保管。未设置（或为空）时 /mcp 路由完全不存在。
# 生成方式：openssl rand -base64 32
# MCP_TOKEN=
# 管理前端的 API 基址。
# 开发：留空即可，请求走 vite 的 /api 代理（见 vite.config.ts）。
# 生产：设为 API 服务的完整 origin，例如 https://kych.net
#       管理前端是独立发布的静态站，没有同源 /api 可以转发，必须显式指定。
VITE_API_BASE_URL=

# 可选：开发代理指向的后端地址，默认 http://127.0.0.1:8080
# VITE_PROXY_TARGET=http://127.0.0.1:8080
